# Copie para .env e preencha.

SECRET_KEY=troque-por-uma-chave-secreta
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=gamelist
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# Origens do frontend em desenvolvimento (CORS + CSRF)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# URL da SPA (destino dos redirects do login via Steam)
FRONTEND_URL=http://localhost:5173

# Integração com a Steam
# Steam Web API Key: https://steamcommunity.com/dev/apikey
# Necessária para sync de biblioteca/conquistas e para puxar nome/avatar do
# perfil. Login OpenID e autofill da loja funcionam sem ela.
STEAM_API_KEY=

# Integração com a RAWG
# RAWG API Key: https://rawg.io/apidocs
# Necessária para o carrossel de "Próximos Lançamentos" da Home. Sem ela, o
# carrossel some (o endpoint degrada para lista vazia).
RAWG_API_KEY=
