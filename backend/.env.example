# Copie para .env e preencha. O .env real NUNCA vai para o git.

SECRET_KEY=troque-por-uma-chave-secreta
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — instância PG 18 local usa a porta 5433 (ver LOG.md)
DB_NAME=gamelist
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# Origens do frontend em desenvolvimento (CORS + CSRF)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
